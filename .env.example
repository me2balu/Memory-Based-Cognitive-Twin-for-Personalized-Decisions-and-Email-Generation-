# ─────────────────────────────────────────────────────────────────────────────
# .env.example
# Copy this file to .env and fill in your real values.
# NEVER commit .env to version control.
# ─────────────────────────────────────────────────────────────────────────────

# Your Google Gemini API key.
# Get one at: https://aistudio.google.com/app/apikey
LLM_API_KEY=api_key

# Gemini model to use.
# Options: gemini-1.5-flash  (fast, free tier)
#          gemini-1.5-pro    (more capable, paid tier)
#          gemini-2.0-flash  (newest fast model)
LLM_MODEL=gemini-1.5-flash

# ─────────────────────────────────────────────────────────────────────────────
# MOCK MODE
# If LLM_API_KEY is not set, the system automatically runs in MOCK MODE.
# Mock responses are clearly labelled [MOCK] and must NOT be used as research
# results.  Set your real API key above for the final demonstration.
# ─────────────────────────────────────────────────────────────────────────────
